# Application Settings
PORT=3001
NODE_ENV=development

# Google OAuth (Google Cloud Console > Identifiants)
GOOGLE_CLIENT_ID=411345636642-5mqq3ufafk17uqfa6ih37ql193v5vgho.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://num-manage-api-ni58.onrender.com/auth/google/callback

# Database (MySQL local par défaut)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=num_manage
# Certificat CA du projet Aiven (Service > Overview > CA Certificate).
# Utilisé uniquement si DB_HOST pointe vers un hôte "*.aivencloud.com" :
# valide le certificat serveur (rejectUnauthorized: true), voir app.module.ts.
DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# JWT
JWT_SECRET=changeme
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme
JWT_REFRESH_EXPIRES_IN=7d

# CORS - domaines autorisés à appeler l'API, séparés par des virgules
FRONTEND_URL=http://localhost:3000,http://localhost:3001,https://num-manage-web.vercel.app

# Initial Seed Accounts (pnpm run seed) — un rôle est ignoré si sa paire
# email/mot de passe n'est pas définie.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=changeme
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=changeme
