# Application Settings
PORT=3001
NODE_ENV=production

# Database Settings (MySQL Aiven)
DB_HOST=your-service-name.aivencloud.com
DB_PORT=00000
DB_USERNAME=avnadmin
DB_PASSWORD="changeme"
DB_DATABASE=defaultdb
# Certificat CA du projet Aiven (Service > Overview > CA Certificate).
# Obligatoire dès que DB_HOST contient "aivencloud.com" : utilisé pour valider
# le certificat serveur (rejectUnauthorized: true), voir app.module.ts.
DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# JWT Configuration
JWT_SECRET="changeme"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="changeme"
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client / Frontend App
FRONTEND_URL=http://localhost:3000

# Initial Seed Accounts (pnpm run seed) — un rôle est ignoré si sa paire
# email/mot de passe n'est pas définie.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD="changeme"
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD="changeme"
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD="changeme"